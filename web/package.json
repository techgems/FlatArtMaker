{
  "name": "flatartmaker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "npm run wasm:engine && npm run wasm:step",
    "wasm:dev": "npm run wasm:engine:dev && npm run wasm:step:dev",
    "wasm:engine": "wasm-pack build ../crates/flatart-wasm --target web --release --no-pack --out-dir ../../web/src/generated/flatart-wasm",
    "wasm:engine:dev": "wasm-pack build ../crates/flatart-wasm --target web --dev --no-pack --out-dir ../../web/src/generated/flatart-wasm",
    "wasm:step": "wasm-pack build ../crates/flatart-wasm-step --target web --release --no-pack --out-dir ../../web/src/generated/flatart-wasm-step",
    "wasm:step:dev": "wasm-pack build ../crates/flatart-wasm-step --target web --dev --no-pack --out-dir ../../web/src/generated/flatart-wasm-step",
    "dev": "npm run wasm:dev && vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run wasm && npm run check && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wasm-pack": "^0.15.1"
  }
}
